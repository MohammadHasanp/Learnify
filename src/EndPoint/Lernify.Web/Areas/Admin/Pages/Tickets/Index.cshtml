@page
@using Common.Domain.Utilities
@using Learnify.Web.Infrastructure.Util
@using TicketModule.Domain
@model Learnify.Web.Areas.Admin.Pages.Tickets.IndexModel
@{
    ViewData["title"] = "مدیریت تیکت ها";
    ViewData["selected"] = "courses_index";
    var count = 0;
}
<form class="card mb-2">
    <div class="card-header mb-0 pb-0 d-flex justify-content-between">
        <h5>فیلتر</h5>
        <div class="">
            <a asp-page="Index" class="btn btn-sm btn-danger">حذف فیلتر</a>
            <button type="submit" class="btn btn-success btn-sm">اعمال فیلتر</button>
        </div>
    </div>
    <div class="card-body mb-0">
        <div class="row">
            <div class="col-md-6">
                <label>وضعیت</label>
                <select class="form-control" asp-for="FilterParams.TicketStatus">
                    <option value="null">همه</option>
                    <option value="@TicketStatus.Answered">پاسخ داده شده</option>
                    <option value="@TicketStatus.Pending">در حال بررسی</option>
                    <option value="@TicketStatus.Closed">بسته شده</option>
                </select>
            </div>
            <div class="col-md-6">
                <label>عنوان</label>
                <input asp-for="@Model.FilterParams.Title" type="text" class="form-control" />
            </div>
        </div>
    </div>
</form>
<div class="card ">
    <div class="table-responsive card-body p-0 mb-0">
        <table class="table table-bordered table-hover mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>عنوان</th>
                    <th>نام خانوادگی</th>
                    <td>وضعیت</td>
                    <th>تاریخ ثبت</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.FilterResult.Datas)
                {
                    <tr>
                        <td>@count</td>
                        <td>@item.Title</td>
                        <td>@item.OwnerFullName</td>
                        <td>
                            @switch (item.TicketStatus)
                            {
                                case TicketStatus.Pending:
                                    <span style="font-size:13px;" class="badge badge-info">درحال برسی</span>
                                    break;

                                case TicketStatus.Answered:
                                    <span style="font-size:13px;" class="badge badge-success">پاسخ داده شده</span>
                                    break;

                                case TicketStatus.Closed:
                                    <span style="font-size:13px;" class="badge badge-danger">بسته شده</span>
                                    break;
                            }
                        </td>
                        <td>
                            @item.CreationDate.ToPersianDate()
                        </td>
                        <td>
                            <a asp-page="Show" asp-route-ticketId="@item.Id" class="btn btn-sm btn-primary">نمایش</a>
                        </td>
                    </tr>
                    count++;
                }

            </tbody>
        </table>
    </div>
</div>
<partial name="_Pagination" model="Model.FilterResult" />
