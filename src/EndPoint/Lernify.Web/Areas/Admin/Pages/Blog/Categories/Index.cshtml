@page
@model Learnify.Web.Areas.Admin.Pages.Blog.Categories.IndexModel
@{
    ViewData["title"] = "دسته بندی های بلاگ";
    ViewData["selected"] = "blog_categories";
}
<a href="#" data-toggle="modal" data-target="#addModal" class="btn btn-success mb-1">افزودن مورد جدید</a>
<div class="card ">
    <div class="table-responsive card-body p-0 mb-0">
        <table class="table table-bordered table-hover mb-0">
            <thead>
                <tr>
                    <th>عنوان</th>
                    <th>slug</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Categories)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.Slug</td>
                        <td>
                            <open-modal-helper class="btn btn-sm btn-primary" modal-title="ویرایش دسته بندی" url="@Url.Page("Index", "ShowEditPage", new { id = item.Id })">ویرایش</open-modal-helper>
                            <delete-item class="btn btn-sm btn-danger" url="@Url.Page("Index", "Delete", new { id = item.Id })">حذف</delete-item>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<div class="modal fade" id="addModal" tabindex="-1" aria-labelledby="editAddressModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editAddressModalLabel">افزودن دسته بندی</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form class="row" >
                    <div class="col-12 col-lg-6 col-md-6 mb-3">
                        <p class="mb-0">
                            <i class="fa fa-user"></i>
                            عنوان :
                        </p>
                        <input asp-for="Title" type="text" class="form-control" placeholder="عنوان">
                        <span class="text-danger" asp-validation-for="Title"></span>
                    </div>

                    <div class="col-12 col-lg-6 col-md-6 mb-3">
                        <p class="mb-0">
                            <i class="fa fa-link"></i>
                            اسلاگ :
                        </p>
                        <input asp-for="Slug" type="text" class="form-control" placeholder="اسلاگ">
                        <span class="text-danger" asp-validation-for="Slug"></span>
                    </div>

                    <div class="col-md-12 d-flex mt-2 justify-content-end">
                        <submit />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>