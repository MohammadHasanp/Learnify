                                توضیحات
                            </a>

                        </div>
                    </div>
                    <div class="tab-content  card shadow   mb-4">
                        <div class=" ">
                             <partial name="Shared/Courses/_CourseSections" model="Model.Course" /> 
                            <div class="Description p-3" style="display: none;">
                                @Html.Raw(Model.Course.Description)
                            </div>
                        </div>
                    </div>
