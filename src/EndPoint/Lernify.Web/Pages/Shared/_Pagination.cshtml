@using Common.Query
@model BasePaginate

@if (Model.PageCount > 1)
{
    <div class="mb-4">
        <div class="paginat col-12">
            @if (Model.StartPage > 1)
            {
                <button class="btn btn-warning btn-sm first" onclick="changePage('1')">
                    1
                </button>
            }
            @for (var item = Model.StartPage; item <= Model.EndPage; item++)
            {
                @if (item == Model.CurrentPage)
                {
                    <button class="btn btn-warning btn-sm current-page">
                        @item
                    </button>
                }
                else
                {
                    <button class="btn btn-warning btn-sm current-page" onclick="changePage(@item)">
                        @item
                    </button>
                }
            }
            @if (Model.EndPage < Model.PageCount)
            {
                <button class="btn btn-warning btn-sm last" onclick="changePage(@Model.PageCount)">
                    <a href="#">@Model.PageCount</a>
                </button>
            }
        </div>
    </div>
}